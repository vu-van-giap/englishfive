doctype html
html
  head
    title Tạo người dùng
    link(rel="stylesheet" href="/static/css/main.css")
    link(rel="stylesheet" href="/static/css/users.css")
  body
    header.navbar
      div.logo EnglishUp
      nav
        a(href='/logout') Đăng xuất
    hr
    main
      h1 Tạo người dùng mới
      form(action="/user" method="POST" enctype="application/x-www-form-urlencoded")
        label(for="fullname") Họ tên:
        input(type="text" name="fullname" placeholder="Nhập họ tên" required)
        br
        label(for="username") Tên đăng nhập:
        input(type="text" name="username" placeholder="Nhập tên đăng nhập" required)
        br
        label(for="role") Vai trò:
        select(name='role')
          option(value='user') Người dùng
          option(value='admin') Quản trị viên
        br
        label(for="password") Mật khẩu:
        input(type="password" name="password" placeholder="Nhập mật khẩu" required)
        br
        button(type="submit") ➕ Tạo người dùng
      br
      a.back(href='/users') ← Quay lại danh sách người dùng
